COMPOSE=docker compose
LAB=$(COMPOSE) --profile tools run --rm --no-deps lab
ORDER_ID ?= order-310
PROTON=$(COMPOSE) --profile amqp10 run --rm --no-deps amqp10-consumer

.PHONY: amqp10 amqp10-pika help check-broker work fanout direct topic topic-key topic-cases headers rpc duplicate redelivery ordering

help:
	@echo "One-shot publishers/clients"
	@echo ""
	@echo "Start the corresponding consumers first with Makefile.services, then run:"
	@echo "  make -f Makefile.publishers work"
	@echo "  make -f Makefile.publishers fanout"
	@echo "  make -f Makefile.publishers direct"
	@echo "  make -f Makefile.publishers topic"
	@echo "  make -f Makefile.publishers topic-key KEY=order.eu.created"
	@echo "  make -f Makefile.publishers topic-cases  # full wildcard exercise"
	@echo "  make -f Makefile.publishers headers"
	@echo "  make -f Makefile.publishers rpc"
	@echo "  make -f Makefile.publishers duplicate"
	@echo "  make -f Makefile.publishers redelivery"
	@echo "  make -f Makefile.publishers ordering"
	@echo "  make -f Makefile.publishers amqp10"
	@echo "  make -f Makefile.publishers amqp10-pika   # optional cross-protocol demo"

check-broker:
	@$(COMPOSE) ps --status running -q rabbitmq | grep -q . || \
		(echo "RabbitMQ is not running. Start services first, for example:"; \
		 echo "  make -f Makefile.services work"; exit 1)

work: check-broker
	$(LAB) python -m demos.work_queue.publisher --count 8

fanout: check-broker
	$(LAB) python -m demos.fanout.publisher --order-id order-123

direct: check-broker
	$(LAB) python -m demos.direct.publisher order.created --order-id order-201
	$(LAB) python -m demos.direct.publisher order.failed --order-id order-202

topic: check-broker
	$(LAB) python -m demos.topic.publisher order.created --order-id order-301
	$(LAB) python -m demos.topic.publisher order.updated --order-id order-301
	$(LAB) python -m demos.topic.publisher order.failed --order-id order-302

# Send any routing key to the existing orders.topic exchange.
# This makes # (zero-or-more words) and * (exactly one word) observable.
topic-key: check-broker
	@test -n "$(KEY)" || (echo "Missing KEY: use make -f Makefile.publishers topic-key KEY=order.eu.created"; exit 1)
	$(LAB) python -m demos.topic.publisher "$(KEY)" --order-id "$(ORDER_ID)"

# All teaching cases in a predictable order (one message per command).
topic-cases: check-broker
	$(LAB) python -m demos.topic.publisher order.created --order-id order-310
	$(LAB) python -m demos.topic.publisher order.updated --order-id order-311
	$(LAB) python -m demos.topic.publisher order.failed --order-id order-312
	$(LAB) python -m demos.topic.publisher order.eu.created --order-id order-313
	$(LAB) python -m demos.topic.publisher order --order-id order-314
	$(LAB) python -m demos.topic.publisher payment.created --order-id order-315
	$(LAB) python -m demos.topic.publisher system.heartbeat --order-id order-316

headers: check-broker
	$(LAB) python -m demos.headers.publisher --type order --region eu
	$(LAB) python -m demos.headers.publisher --type order --region us
	$(LAB) python -m demos.headers.publisher --type payment --region eu

rpc: check-broker
	$(LAB) python -m demos.request_reply.client --order-id order-401 --subtotal 25.50
	$(LAB) python -m demos.request_reply.client --order-id order-402 --subtotal 42.00

duplicate: check-broker
	$(LAB) python -m demos.reliability.duplicate_publisher

redelivery: check-broker
	$(LAB) python -m demos.reliability.redelivery_publisher

ordering: check-broker
	$(LAB) python -m demos.ordering.publisher

# Proton uses AMQP 1.0. The Docker image is built by Makefile.services amqp10.
amqp10: check-broker
	$(PROTON) python -m demos.amqp10.publisher --count 3

# Pika uses AMQP 0-9-1, consumed by the same Proton AMQP 1.0 receiver.
amqp10-pika: check-broker
	$(LAB) python -m demos.amqp10.pika_publisher

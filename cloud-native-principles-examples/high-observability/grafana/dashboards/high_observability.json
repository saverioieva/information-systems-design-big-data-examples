{
  "id": null,
  "uid": "high-observability",
  "title": "High Observability Dashboard",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (status) (rate(observability_http_requests_total{endpoint=\"/catalog\"}[1m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 7}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average Request Duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(observability_http_request_duration_seconds_sum{endpoint=\"/catalog\"}[1m]) / rate(observability_http_request_duration_seconds_count{endpoint=\"/catalog\"}[1m])",
          "legendFormat": "duration"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 7}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Readiness",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "observability_readiness",
          "legendFormat": "ready"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 6}
    }
  ]
}

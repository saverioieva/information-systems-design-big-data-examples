{
    "Comment": "Input and Output Demo",
    "StartAt": "FirstState",
    "States": {
		"FirstState": {
			"Type": "Task",
			"Resource": "arn:aws:lambda:us-east-1:000000000000:function:lambda-io",
			"InputPath": "$.customer",
			"Parameters": {
				"name.$": "$.name",
				"email.$": "$.email",
				"orderId.$": "$$.Execution.Input.orderId"
			},				
			"ResultPath": "$.orderResult",
			"OutputPath": "$.orderResult",
			"Next": "FinalState"
		},
		"FinalState": {       
            "Type": "Succeed"   
        }
	}
}
{
    "Comment": "Parallel Demo",
    "StartAt": "Parallel State",
    "States": {
		"Parallel State": {
			"Type": "Parallel",
			"Next": "combine",
			"Branches": [
				{
					"StartAt": "lambda1",
					"States": {
						"lambda1": {
							"Type": "Task",
							"Resource": "arn:aws:states:::lambda:invoke",
							"Parameters": {
								"FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:lambda-1",
								"Payload": {"input.$": "$"}
							},
							"OutputPath": "$.Payload",
							"End": true
						}
					}
				},
				{
					"StartAt": "lambda2",
					"States": {
						"lambda2": {
							"Type": "Task",
							"Resource": "arn:aws:states:::lambda:invoke",
							"Parameters": {
								"FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:lambda-2",
								"Payload": {"input.$": "$"}
							},
							"OutputPath": "$.Payload",
							"End": true
						}
					}
				}
			]
		},
		"combine": {
			"Type": "Task",
			"Resource": "arn:aws:states:::lambda:invoke",
			"Parameters": {
				"FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:combine",
				"Payload": {"input.$": "$"}
			},
			"OutputPath": "$.Payload",
			"End": true
		}
	}
}